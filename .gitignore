# Step 4 Component 4 (growth-tools-config.ts) — platform-level MCP/tool
# credentials, day2-operator-owned, never per-app or owner-supplied. Real
# secrets never get committed; .day2-platform-tools.example.json documents
# the shape with placeholder values only.
.day2-platform-tools.json

# day2 console (day2 console plan §4) — the multi-app registry and any
# zip-uploaded/cloned app checkouts it manages. `repoPath` values are
# absolute, machine-specific paths meaningless in version control;
# managed-repos/ holds real extracted/cloned source trees that don't belong
# in the orchestrator's own history.
.day2-apps.json
managed-repos/

# Generated run output — append-only, machine/run-specific, not source.
