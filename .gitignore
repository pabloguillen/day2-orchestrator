node_modules/
test-reports/
*.log
.env

# Step 4 Component 4 (growth-tools-config.ts) — platform-level MCP/tool
# credentials, day2-operator-owned, never per-app or owner-supplied. Real
# secrets never get committed; .day2-platform-tools.example.json documents
# the shape with placeholder values only.
.day2-platform-tools.json

# day2 console (day2 console plan §4) — the multi-app registry and any
# zip-uploaded/cloned app checkouts it manages. `repoPath` values are
# absolute, machine-specific paths meaningless in version control;
# managed-repos/ holds real extracted/cloned source trees that don't belong
# in the orchestrator's own history.
.day2-apps.json
managed-repos/

# Generated run output — append-only, machine/run-specific, not source.
# Same precedent as removing the orchestrator state file from tracking
# (expense-buddy's "remove-orchestrator-state-file" commit).
day2-proposals.jsonl
day2-release-results.jsonl
day2-autonomy-audit.jsonl
worktrees-tmp-check/

# Account-wide credits (credits.ts) — the operator's balance and ledger,
# machine/account data, not source.
.day2-credits-account.json
.day2-credits-ledger.jsonl
.day2-credits.lock/

# JIRA / Linear connections per app (backlog-trackers.ts) — customer API
# tokens, never committed.
.day2-integrations.json

# day2's own Lovable account (lovable.ts): OAuth tokens and build records.
.day2-lovable.json
.day2-lovable-builds.json

# Production settings and local backups (deploy/).
deploy/.env
deploy/backups/

# Connected tools (connectors.ts) — OAuth tokens, local mode only.
.day2-connectors.json
