# day2 production settings. Copy to deploy/.env (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 32

# Where people reach day2 (DNS A record pointing at this server).
DAY2_DOMAIN=app.example.com

# Database password (any long random string).
POSTGRES_PASSWORD=

# Encrypts customer secrets (JIRA/Linear tokens) in the database.
# 32 random bytes, base64. Keep a copy somewhere safe: without it, stored
# connections can't be read and people have to reconnect.
DAY2_SECRETS_KEY=

# ---- Ways to sign in (set up at least one; see docs/deploy-hetzner.md §3) ----

# Email sign-in links and invitations.
SMTP_URL=
MAIL_FROM="day2 <hello@example.com>"

# Continue with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----

# Claude, for all agent work.
ANTHROPIC_API_KEY=

# day2's GitHub App (docs/deploy-hetzner.md → "Create the GitHub App").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's private key, on one line with \n for line breaks:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' day2.private-key.pem
GITHUB_APP_PRIVATE_KEY=

# GitHub usernames of the people who run day2 (comma-separated) — they can
# connect day2's own Lovable account.
DAY2_OPERATOR_LOGINS=

# Creating apps with Lovable stays off until Lovable confirms the use.
DAY2_FEATURE_CREATE_APPS=off

# How often backlogs move on their own (minutes; 0 = off).
DAY2_BACKLOG_TICK_MINUTES=15

# Optional
# SENTRY_AUTH_TOKEN=
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=03
# CONSOLE_DIR=../../console
